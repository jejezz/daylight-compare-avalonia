<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:DaylightCompare.App.Icons"
        x:Class="DaylightCompare.App.HomeWindow"
        Title="Daylight Compare"
        Width="1200" Height="720" MinWidth="960" MinHeight="600"
        DragDrop.AllowDrop="True">
    <Grid RowDefinitions="44,*">
        <!-- 앱 바 44 (ui-ux.md §4), 오른쪽 끝은 설정 | 정보 -->
        <Border Grid.Row="0" Background="{DynamicResource AppSurface}"
                BorderBrush="{DynamicResource AppStroke}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="AppTitle" VerticalAlignment="Center"
                           FontWeight="ExtraBold" FontSize="{DynamicResource FsTitle}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="SettingsButton" Classes="tool" ToolTip.Tip="{DynamicResource Str.SettingsTooltip}">
                        <icons:DuoIcon Icon="settings"/>
                    </Button>
                    <Button x:Name="AboutButton" Classes="tool" ToolTip.Tip="{DynamicResource Str.AboutTooltip}">
                        <icons:DuoIcon Icon="info"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 새 비교: 왼쪽·오른쪽을 고르거나 창 어디에든 끌어다 놓는다 (ROADMAP §6-1 ①). 저장한 세션·최근 목록은 4단계. -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" Width="640">
            <icons:DuoIcon Icon="compare" Width="48" Height="48" HorizontalAlignment="Center"/>
            <TextBlock Text="{DynamicResource Str.HomeEmptyTitle}" HorizontalAlignment="Center"
                       FontWeight="Bold" FontSize="{DynamicResource FsMid}"/>
            <TextBlock Text="{DynamicResource Str.HomeEmptyHint}" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Foreground="{DynamicResource AppTextMid}" FontSize="{DynamicResource FsSmall}"/>
            <Border Classes="card" Padding="16" Margin="0,8,0,0">
                <Grid RowDefinitions="Auto,8,Auto,16,Auto" ColumnDefinitions="72,*,Auto" ColumnSpacing="12">
                    <TextBlock Grid.Row="0" Text="{DynamicResource Str.HomeLeft}" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="LeftPath" VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis"
                               Foreground="{DynamicResource AppTextMid}"/>
                    <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PickLeftFolder" Content="{DynamicResource Str.HomeChooseFolder}"/>
                        <Button x:Name="PickLeft" Content="{DynamicResource Str.CompareOpen}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="{DynamicResource Str.HomeRight}" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RightPath" VerticalAlignment="Center" TextTrimming="PathSegmentEllipsis"
                               Foreground="{DynamicResource AppTextMid}"/>
                    <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="PickRightFolder" Content="{DynamicResource Str.HomeChooseFolder}"/>
                        <Button x:Name="PickRight" Content="{DynamicResource Str.CompareOpen}"/>
                    </StackPanel>
                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <!-- 파일 없이 글을 붙여 넣어 비교 (클립보드 비교, ROADMAP §6-1) -->
                        <Button x:Name="PasteCompareButton" Content="{DynamicResource Str.HomePasteCompare}"/>
                        <Button x:Name="CompareButton" Classes="accent" Content="{DynamicResource Str.HomeCompare}" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 끌고 들어오면 창 전체를 강조 (ui-ux.md §7) -->
        <Border Grid.Row="0" Grid.RowSpan="2" x:Name="DropHint" IsVisible="False" IsHitTestVisible="False"
                BorderBrush="{DynamicResource AppPrimary}" BorderThickness="2"/>
    </Grid>
</Window>
